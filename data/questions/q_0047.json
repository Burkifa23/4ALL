  "title": "Minimum Possible Integer After At Most K Adjacent Swaps On Digits",
  "difficulty": 3,
  "topic": "Greedy",
  "topics": [
    "Greedy",
    "Binary Indexed Tree",
    "Segment Tree",
    "String"
